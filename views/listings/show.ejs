<% layout("./layouts/boilerplate.ejs") %>
    <script>
    const mapToken = "<%= mapToken %>";
    const listing = <%- JSON.stringify(listings) %>;
</script>

    <div class="row">
        <div class="col-8 offset-3">
            <h3>
                <%=listings.title%>
            </h3>
        </div>

        <div class="col-6 offset-3 mt-2 show-card">
            <div class="card listing-card">
                <img src="<%=listings.image.url%>" class="card-img-top" alt="list image" height="200vh">
                <div class="card-body">
                    <p class="card-text">Owned by <i>
                            <%=listings.owner.username%>
                        </i></p>
                    <p class="card-text">
                        <%=listings.description%>
                    </p>
                    <p class="card-text">&#8377;<%=listings.price.toLocaleString("en-In")%></p>
                    <p class="card-text">
                        <%=listings.location%>
                    </p>
                    <p class="card-text">
                        <%=listings.country%>
                    </p>
                </div>
            </div>
        </div>
        <%if(currUser && currUser._id.equals(listings.owner._id)){%>
            <div class="btns mb-3">
                <a href="/listing/<%=listings._id%>/edit" class="btn btn-dark col-1 offset-3">Edit</a><br>
                <form method="post" action="/listing/<%=listings._id%>?_method=DELETE">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>
            </div>
            <%}%>

                <div class="col-6 offset-3 mb-3 mt-3">
                    <hr>
                    <%if(currUser){%>

                        <h4>Leave a review</h4>
                        <form action="/listing/<%=listings._id%>/reviews" method="POST" novalidate
                            class="needs-validation">
                            <div class="mb-3 mt-3">
                                <label for="rating" class="form-label">Rating</label>
                                <fieldset class="starability-grow">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                        value="1" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea cols="30" rows="5" name="review[comment]" id="comment" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">
                                    <p>Please add some comment </p>
                                </div>
                            </div>
                            <button class="btn btn-outline-dark">Submit</button>
                        </form>
                        <hr>
                        <%}%>
                            <% if(listings.reviews.length>0){%>
                                <div class="row">
                                    <p><b>All reviews</b></p>
                                    <% for (review of listings.reviews){%>
                                        <div class="card col-5 mb-3 ms-2">
                                            <div class="card-body">
                                                <div class="card-title"><b><i>@<%=review.author.username%></i></b></div>
                                                <p class="starability-result card-text"
                                                    data-rating="<%= review.rating%>">
                                                </p>
                                                <p class="card-text">
                                                    <%= review.comment%>
                                                </p>
                                            </div>
                                            <form method="POST"
                                                action="/listing/<%=listings._id%>/reviews/<%=review._id%>?_method=DELETE"
                                                class="mb-2 mt-2">
                                                <button class="btn btn-sm btn-dark">Delete</button>
                                            </form>
                                        </div>

                                        <%}%>
                                </div>
                                <%}%>
                </div>
                <div class="col-6 offset-3 mb-3">
                    <h3>Where you will be</h3>
                    <div id="map"></div>
                </div>

                <script src="/js/map.js"></script>





    </div>